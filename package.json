{
  "name": "ledgerlink",
  "private": true,
  "version": "1.0.0",
  "description": "LedgerLink — archive WhatsApp and Telegram chats into Obsidian",
  "author": "Mohamed <mohamednabarawy@gmail.com>",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "build": "vite build",
    "prepare:whisper": "node scripts/prepare-whisper.cjs",
    "verify:release": "node scripts/verify-release-safe.cjs",
    "dist:win": "npm run prepare:whisper && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64",
    "release:win": "npm run dist:win && npm run verify:release",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "lucide-react": "^1.17.0",
    "pdfjs-dist": "^6.0.227",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-resizable-panels": "^4.11.2",
    "sharp": "^0.34.5",
    "telegram": "^2.26.22",
    "tesseract.js": "^7.0.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.0.12",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.ledgerlink.desktop",
    "productName": "LedgerLink",
    "copyright": "Copyright © 2026 Mohamed",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.md",
      "!scripts/**",
      "!tools/**",
      "!.env",
      "!.env.*",
      "!**/.env",
      "!account-tray*.png",
      "!desktop-shell*.png",
      "!whatsapp-archiver*.png",
      "!eslint.config.js",
      "!vite.config.js",
      "!setup-whisper.cjs"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/node_modules/tesseract.js/**",
      "**/node_modules/tesseract.js-core/**",
      "**/node_modules/whatsapp-web.js/**",
      "**/node_modules/puppeteer/**",
      "**/node_modules/puppeteer-core/**",
      "**/node_modules/@puppeteer/**",
      "**/node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "tools/whisper.cpp/cpu/Release",
        "to": "whisper-cpp/cpu",
        "filter": ["**/*"]
      },
      {
        "from": ".env.example",
        "to": "env.example"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "public/ledgerlink_logo.png",
      "artifactName": "LedgerLink-${version}-Windows-x64.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "LedgerLink",
      "artifactName": "LedgerLink-${version}-Windows-x64-Setup.${ext}"
    }
  }
}
